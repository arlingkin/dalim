<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/window_bg">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="@string/module_battery"
        app:titleTextColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== Status card ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/batteryStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_status_unknown"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#9AA0A6"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/batteryLevelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="--"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />

                    <TextView
                        android:id="@+id/batteryEstimateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/battery_no_estimate"
                        android:textSize="14sp"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/batteryDrainText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/batteryBudgetUsageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#5F6368" />

                    <TextView
                        android:id="@+id/batteryTempVoltageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#9AA0A6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/battery_discharge_note"
                        android:textSize="11sp"
                        android:textColor="#9AA0A6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Budget card ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_budget"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#9AA0A6"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/floorLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#5F6368" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/floorSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="20"
                        android:valueFrom="0"
                        android:valueTo="50"
                        android:stepSize="1" />

                    <TextView
                        android:id="@+id/startLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="#5F6368" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/startSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:value="100"
                        android:valueFrom="21"
                        android:valueTo="100"
                        android:stepSize="1" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBatteryAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="6dp"
                        app:useMaterialThemeColors="false"
                        app:thumbTint="#0D47A1"
                        app:trackTint="#B9C7D6"
                        android:text="@string/battery_alerts"
                        android:textColor="#202124" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>